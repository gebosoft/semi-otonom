<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SemiOtonom.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!-- Domain'in soyutlamalarını (IUnitOfWork, repository arayüzleri) ve ileride
       Application/Abstractions altındaki sözleşmeleri implement eder. -->
  <ItemGroup>
    <ProjectReference Include="..\Domain\SemiOtonom.Domain.csproj" />
    <ProjectReference Include="..\Application\SemiOtonom.Application.csproj" />
  </ItemGroup>

  <!-- Henüz veritabanı yok: bilinçli olarak hiç EF Core paketi eklenmedi.
       AppDbContext, repository implementasyonları ve migration'lar ilk gerçek
       feature ile gelecek. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
