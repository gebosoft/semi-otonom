<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- DİKKAT: bu projenin assembly adı (Api) contracts/Api.json dosya adını, OpenAPI
       "Api | v1" başlığını ve tags[0].name değerini belirliyor; yeniden adlandırma
       sözleşme zincirini kırar. Aşağıdaki üç OpenApi* özelliği de derleme sırasında
       contracts/ klasörüne üretimi sağlıyor — OpenApiDocumentsDirectory göreli yolu
       bu projenin api/src/Api altındaki derinliğine bağlı. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../contracts</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_0</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\SemiOtonom.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\SemiOtonom.Infrastructure.csproj" />
  </ItemGroup>

</Project>
